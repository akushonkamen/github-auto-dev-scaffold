# ──────────────────────────────────────────────────────────────────────────
# GithubAutoDev App v1 — environment variable placeholders (PRD §4.4)
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored —
# NEVER commit secrets (PRD §7 S4). These keys must be scoped per-environment
# and rotated (PRD §7 S6 for any PAT).
# ──────────────────────────────────────────────────────────────────────────

# ── Next.js / next-auth v4 (Issue #3) ──────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# ── GitHub OAuth App (user sign-in, Issue #3) ─────────────────────────────
GITHUB_ID=
GITHUB_SECRET=

# ── GitHub App (engine runner via repository_dispatch / workflow_dispatch) ─
GITHUB_APP_ID=
# base64-encoded PEM (so newlines survive env var transport):
#   base64 -i app.private-key.pem | tr -d '\n'
APP_PRIVATE_KEY=
# Fine-grained PAT fallback (S6: single-repo scope, minimal perms, ≤90d)
GITHUB_PAT=

# ── GitHub App OAuth (NextAuth provider, Issue #3) ────────────────────────
# App ID from GitHub App settings (https://github.com/settings/apps/gitautodev)
APP_ID=
APP_CLIENT_ID=
APP_CLIENT_SECRET=

# ── Database — Drizzle ORM + Postgres (Issue #2) ───────────────────────────
# v1 uses Neon Postgres (ap-east-1). Provisioning steps in
# docs/app-launch-checklist.md A3-6. The connection string below is a template;
# replace with your actual Neon pooled or direct connection string.
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# ── Upstash Redis (cache / rate-limit / webhook dedup, Issue #5) ───────────
# Used by the worker route to SETNX on X-GitHub-Delivery for 24h dedup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Upstash QStash (webhook queue / background jobs, Issue #4) ─────────────
QSTASH_URL=
QSTASH_TOKEN=
# Signing keys for verifying upstash-signature on the worker route
# (Issue #5). Different from QSTASH_TOKEN — these are Ed25519 keys from
# https://console.upstash.com/qstash
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── GitHub webhook secret (Issue #4) ───────────────────────────────────────
# HMAC-SHA256 key used to verify X-Hub-Signature-256 on /api/webhook/github.
# Generate with: openssl rand -hex 32
# Configure the same value in the GitHub App's webhook secret field.
WEBHOOK_SECRET=

# ── BYOK master key (Issue #8) ─────────────────────────────────────────────
# AES-256-GCM master key for encrypting api_keys.encrypted_key. MUST be 32
# bytes encoded as base64 (44 chars no padding). Generate with:
#   openssl rand -base64 32
# Rotating this key invalidates all stored BYOK rows (re-encrypt required).
APP_BYOK_MASTER_KEY=

# ── Stripe (billing — Issue #10) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price ID for the Pro plan (monthly subscription). Create at
# https://dashboard.stripe.com/products → copy `price_...` ID.
STRIPE_PRO_PRICE_ID=

# ── BYOK — Bring Your Own Key (Issue #8) ────────────────────────────────────
# Master key for AES-256-GCM encryption of user-provided API keys.
# Must be exactly 32 bytes, base64-encoded:
#   openssl rand -base64 32
# Missing, malformed, or non-32-byte values cause a 500 error — never falls
# back to a hardcoded key (PRD §7 S9).
APP_BYOK_MASTER_KEY=

# ── Public ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
